{
  "name": "crm-ai-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings=0 --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "verify": "npm run prisma:validate && npm run typecheck && npm run lint:ci",
    "prisma:generate": "prisma generate",
    "prisma:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "db:setup": "node prisma/setup-sqlite.mjs && npm run prisma:seed"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
