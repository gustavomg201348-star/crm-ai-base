generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OpenCreditConsumerAuthorization {
  cltAiSimulations OpenCreditAiSimulation[]
  id String @id @default(cuid())
  companyId String
  contactId String
  remoteIdentityId String
  providerScope String
  purpose String
  evidenceInboundEventId String
  active Boolean
  revision Int
  changedByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuth_company_fkey")
  contact Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuth_contact_fkey")
  remoteIdentity OpenCreditRemoteIdentity @relation(fields: [remoteIdentityId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuth_identity_fkey")
  evidence ConversationInboundEvent @relation("ConsumerAuthorizationEvidence", fields: [evidenceInboundEventId, companyId, contactId], references: [id, companyId, contactId], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuth_evidence_fkey")
  changedBy User @relation("ConsumerAuthorizationChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuth_actor_fkey")
  events OpenCreditConsumerAuthorizationEvent[]
  @@unique([companyId, providerScope, contactId, purpose], map: "OCConsumerAuth_company_scope_contact_purpose_key")
  @@unique([id, companyId, providerScope], map: "OCConsumerAuth_id_company_scope_key")
  @@index([remoteIdentityId], map: "OCConsumerAuth_identity_idx")
  @@index([changedByUserId], map: "OCConsumerAuth_actor_idx")
  @@index([companyId, providerScope, active], map: "OCConsumerAuth_scope_active_idx")
  @@index([evidenceInboundEventId], map: "OCConsumerAuth_evidence_idx")
}

model OpenCreditConsumerAuthorizationEvent {
  dispatchOperations OpenCreditCommercialOperationEvent[] @relation("OpenCreditOperationDispatchAuthorizationEvent")
  id String @id @default(cuid())
  authorizationId String
  companyId String
  providerScope String
  actorUserId String
  action String
  previousActive Boolean?
  nextActive Boolean
  revision Int
  evidenceInboundEventId String
  createdAt DateTime @default(now())
  authorization OpenCreditConsumerAuthorization @relation(fields: [authorizationId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuthEvent_authorization_fkey")
  actor User @relation("ConsumerAuthorizationEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuthEvent_actor_fkey")
  evidence ConversationInboundEvent @relation("ConsumerAuthorizationEventEvidence", fields: [evidenceInboundEventId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OCConsumerAuthEvent_evidence_fkey")
  @@unique([authorizationId, revision], map: "OCConsumerAuthEvent_authorization_revision_key")
  @@unique([id, companyId, providerScope], map: "OCConsumerAuthEvent_id_company_scope_key")
  @@index([authorizationId, createdAt, id], map: "OCConsumerAuthEvent_authorization_idx")
  @@index([actorUserId], map: "OCConsumerAuthEvent_actor_idx")
  @@index([evidenceInboundEventId], map: "OCConsumerAuthEvent_evidence_idx")
}

model ConversationInboundEvent {
  cltAiSimulations OpenCreditAiSimulation[]
  provenanceKind String?
  provenanceVersion Int?
  id             String @id @default(cuid())
  companyId      String
  contactId      String
  channelId      String?
  conversationId String
  messageId      String @unique(map: "InboundEvent_message_key")
  sequence       BigInt
  createdAt      DateTime @default(now())
  company        Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "InboundEvent_company_fkey")
  contact        Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "InboundEvent_contact_fkey")
  channel        Channel? @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "InboundEvent_channel_fkey")
  conversation   Conversation @relation("InboundEventConversation", fields: [conversationId, contactId], references: [id, contactId], onDelete: Restrict, onUpdate: NoAction, map: "InboundEvent_conversation_fkey")
  channelConversation Conversation? @relation("InboundEventChannel", fields: [conversationId, contactId, channelId], references: [id, contactId, channelId], onDelete: Restrict, onUpdate: NoAction, map: "InboundEvent_channel_conversation_fkey")
  message        Message @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Restrict, onUpdate: NoAction, map: "InboundEvent_message_fkey")

  consumerAuthorizations OpenCreditConsumerAuthorization[] @relation("ConsumerAuthorizationEvidence")
  consumerAuthorizationEvents OpenCreditConsumerAuthorizationEvent[] @relation("ConsumerAuthorizationEventEvidence")
  @@unique([id, companyId, contactId], map: "InboundEvent_id_company_contact_key")
  @@unique([messageId, conversationId], map: "InboundEvent_message_conversation_key")
  @@unique([conversationId, sequence], map: "InboundEvent_conversation_sequence_key")
  @@index([companyId, channelId, createdAt], map: "InboundEvent_scope_created_idx")
}

model ConversationAuthority {
  id             String @id @default(cuid())
  companyId      String
  channelId      String
  contactId      String
  conversationId String @unique
  state          String
  generation     BigInt @default(0)
  ownerUserId    String?
  owner          User? @relation("AuthorityOwner", fields: [companyId, ownerUserId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  policyVersion  Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contact        Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  channel        Channel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  conversation   Conversation @relation(fields: [conversationId, contactId, channelId], references: [id, contactId, channelId], onDelete: Restrict, onUpdate: Restrict)
  operations     OutboundOperation[]
  events         AuthorityEvent[]
  @@unique([companyId, channelId, conversationId, id])
  @@unique([conversationId, contactId, channelId])
  @@index([companyId, channelId, state])
}

model OutboundOperation {
  openCreditWhatsappHandoffs OpenCreditWhatsappHandoff[]
  id                 String @id @default(cuid())
  companyId          String
  channelId          String
  conversationId     String
  authorityId        String
  logicalKey         String
  fingerprint        String
  origin             String
  actorUserId        String?
  actor              User? @relation("OutboundActor", fields: [companyId, actorUserId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  payload            String
  authorityGeneration BigInt
  status             String @default("PREPARED")
  activeSlot         String? @unique
  reservationToken   String?
  leaseUntil         DateTime?
  dispatchDeadline   DateTime?
  providerMessageId  String?
  resultFingerprint  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  authority          ConversationAuthority @relation(fields: [companyId, channelId, conversationId, authorityId], references: [companyId, channelId, conversationId, id], onDelete: Restrict, onUpdate: Restrict)
  events             AuthorityEvent[]
  @@unique([companyId, channelId, conversationId, id])
  @@unique([companyId, channelId, logicalKey])
  @@unique([companyId, channelId, providerMessageId])
  @@index([authorityId, status])
  @@index([status, leaseUntil])
}

model AuthorityEvent {
  id             String @id @default(cuid())
  companyId      String
  channelId      String
  conversationId String
  authorityId    String
  logicalKey     String
  fingerprint    String
  actorUserId    String
  actor          User @relation("AuthorityActor", fields: [companyId, actorUserId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  kind           String
  fromState      String?
  toState        String
  fromGeneration BigInt
  toGeneration   BigInt
  fromOwnerUserId String?
  toOwnerUserId   String?
  auditTransactionId String @default("")
  operationId    String?
  operation      OutboundOperation? @relation(fields: [companyId, channelId, conversationId, operationId], references: [companyId, channelId, conversationId, id], onDelete: Restrict, onUpdate: Restrict)
  reason         String
  createdAt      DateTime @default(now())
  authority      ConversationAuthority @relation(fields: [companyId, channelId, conversationId, authorityId], references: [companyId, channelId, conversationId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([companyId, channelId, logicalKey])
  @@index([authorityId, createdAt])
}

model ChatbotReplyCorrelation {
  id                       String @id @default(cuid())
  companyId                String
  channelId                String
  conversationId           String
  contactId                String
  inboundMessageId         String @unique
  providerMessageId        String
  contextProviderMessageId String?
  interactionType          String
  optionId                 String?
  optionTitle              String?
  optionIdentity           String
  sourceTimestamp          DateTime?
  timestampRaw             String?
  senderIdentityHash       String
  fingerprint              String
  limitations              String @default("[]")
  status                   String @default("NOT_FOUND")
  reason                   String
  sourceMessageId          String?
  templateName             String?
  templateLanguage         String?
  campaignId               String?
  campaignRecipientId      String?
  candidateFlowId          String?
  candidateVersionId       String?
  flowCandidateStatus      String @default("UNCONFIGURED")
  confirmedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  channel                  Channel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction)
  contact                  Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Cascade, onUpdate: NoAction)
  conversation             Conversation @relation(fields: [conversationId, contactId, channelId], references: [id, contactId, channelId], onDelete: Cascade, onUpdate: NoAction)
  inboundMessage           Message @relation("ChatbotReplyInbound", fields: [inboundMessageId, conversationId], references: [id, conversationId], onDelete: Cascade, onUpdate: NoAction)
  sourceMessage            Message? @relation("ChatbotReplySource", fields: [sourceMessageId, conversationId], references: [id, conversationId], onDelete: Cascade, onUpdate: NoAction)
  campaign                 Campaign? @relation(fields: [companyId, channelId, campaignId], references: [companyId, channelId, id], onDelete: Cascade, onUpdate: NoAction)
  recipient                CampaignRecipient? @relation(fields: [campaignId, campaignRecipientId, contactId, conversationId], references: [campaignId, id, contactId, conversationId], onDelete: Cascade, onUpdate: NoAction)
  candidateVersion         ChatbotFlowVersion? @relation(fields: [companyId, candidateFlowId, candidateVersionId], references: [companyId, flowId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([companyId, channelId, providerMessageId])
  @@index([companyId, channelId, status, createdAt])
  @@index([companyId, campaignId])
}

model ChatbotFlow {
  id                 String @id @default(cuid())
  companyId          String
  name               String
  description        String?
  isActive           Boolean @default(true)
  publishedVersionId String?
  versionCounter     Int @default(1)
  revision           Int @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versions           ChatbotFlowVersion[] @relation("ChatbotFlowVersions")
  publishedVersion   ChatbotFlowVersion? @relation("PublishedChatbotVersion", fields: [companyId, id, publishedVersionId], references: [companyId, flowId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, id])
  @@index([companyId, isActive])
}

model ChatbotFlowVersion {
  id           String @id @default(cuid())
  companyId    String
  flowId       String
  number       Int
  status       String @default("DRAFT")
  definition   String
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  flow         ChatbotFlow @relation("ChatbotFlowVersions", fields: [companyId, flowId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  publishedFor ChatbotFlow[] @relation("PublishedChatbotVersion")
  replyCorrelations ChatbotReplyCorrelation[]
  sessions     ChatbotSession[]

  @@unique([companyId, flowId, number])
  @@unique([companyId, flowId, id])
}

model ChatbotSession {
  id                   String @id @default(cuid())
  companyId            String
  channelId            String
  conversationId       String
  contactId            String
  flowId               String
  flowVersionId        String
  campaignId           String?
  campaignRecipientId  String?
  activeConversationId String? @unique
  currentStepId        String
  status               String @default("ACTIVE")
  authority            String @default("CHATBOT")
  revision             Int @default(0)
  expiresAt            DateTime
  suspensionReason     String?
  closureReason        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  endedAt              DateTime?
  channel              Channel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  contact              Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  conversation         Conversation @relation(fields: [conversationId, contactId, channelId], references: [id, contactId, channelId], onDelete: Restrict, onUpdate: NoAction)
  version              ChatbotFlowVersion @relation(fields: [companyId, flowId, flowVersionId], references: [companyId, flowId, id], onDelete: Restrict, onUpdate: NoAction)
  campaign             Campaign? @relation(fields: [companyId, channelId, campaignId], references: [companyId, channelId, id], onDelete: Restrict, onUpdate: NoAction)
  recipient            CampaignRecipient? @relation(fields: [campaignId, campaignRecipientId, contactId, conversationId], references: [campaignId, id, contactId, conversationId], onDelete: Restrict, onUpdate: NoAction)
  events               ChatbotEvent[]
  outbox               ChatbotOutbox[]

  @@unique([companyId, channelId, id])
  @@index([companyId, conversationId, createdAt])
  @@index([status, expiresAt])
}

model ChatbotEvent {
  id                      String @id @default(cuid())
  companyId               String
  channelId               String
  sessionId               String
  idempotencyKey          String
  fingerprint             String
  sessionRevision         Int?
  kind                    String
  payload                 String
  occurredAt              DateTime
  status                  String @default("PENDING")
  attempts                Int @default(0)
  maxAttempts             Int @default(3)
  availableAt             DateTime @default(now())
  leaseUntil              DateTime?
  leaseToken              String?
  processedAt             DateTime?
  errorCode               String?
  createdAt               DateTime @default(now())
  session                 ChatbotSession @relation(fields: [companyId, channelId, sessionId], references: [companyId, channelId, id], onDelete: Restrict, onUpdate: NoAction)
  commands                ChatbotOutbox[]

  @@unique([companyId, channelId, idempotencyKey])
  @@unique([companyId, channelId, sessionId, id])
  @@index([status, availableAt])
}

model ChatbotOutbox {
  id              String @id @default(cuid())
  companyId       String
  channelId       String
  sessionId       String
  eventId         String
  idempotencyKey  String
  payload         String
  status          String @default("PENDING")
  attempts        Int @default(0)
  maxAttempts     Int @default(3)
  availableAt     DateTime @default(now())
  leaseUntil      DateTime?
  leaseToken      String?
  providerMessageId String?
  errorCode       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  session         ChatbotSession @relation(fields: [companyId, channelId, sessionId], references: [companyId, channelId, id], onDelete: Restrict, onUpdate: NoAction)
  event           ChatbotEvent @relation(fields: [companyId, channelId, sessionId, eventId], references: [companyId, channelId, sessionId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([companyId, channelId, idempotencyKey])
  @@index([status, availableAt])
}


model Company {
  openCreditConsumerAuthorizations OpenCreditConsumerAuthorization[]
  id            String          @id @default(cuid())
  name          String
  email         String?
  phone         String?
  segment       String?
  aiMode        String          @default("COPILOT")
  aiInstructions String?
  createdAt     DateTime        @default(now())
  users         User[]
  contacts      Contact[]
  multicredClients MulticredClient[]
  multicredBanks MulticredBank[]
  multicredProducts MulticredProduct[]
  retirementLeads RetirementLead[]
  channels      Channel[]
  campaigns     Campaign[]
  notifications Notification[]
  tags          Tag[]
  conversationTags ConversationTag[]
  stages        PipelineStage[]
  origins       Origin[]
  proposals     Proposal[]
  tasks         Task[]
  cltIntegrations CltIntegration[]
  cltSimulationLogs CltSimulationLog[]
  userAvailabilities UserAvailability[]
  leadAssignmentSetting LeadAssignmentSetting?
  leadAssignmentHistory LeadAssignmentHistory[]
  nextBestActionEvents NextBestActionEvent[]
  metaTemplates MetaTemplate[]
  mediaAssets   MediaAsset[]
  openCreditIntegrations OpenCreditIntegration[]
  openCreditLeads OpenCreditLead[]
  openCreditEvents OpenCreditEvent[]
  openCreditCommercialAccesses OpenCreditCommercialAccess[]
  openCreditCommercialOperations OpenCreditCommercialOperation[]
  openCreditRemoteIdentities OpenCreditRemoteIdentity[]
  chatbotFlows ChatbotFlow[]
  inboundEvents ConversationInboundEvent[]
  contactImportBatches ContactImportBatch[]
}

model ContactImportBatch {
  id             String   @id @default(cuid())
  companyId      String
  idempotencyKey String
  payloadHash    String
  resultVersion  Int      @default(1)
  resultJson     String
  createdAt      DateTime @default(now())
  completedAt    DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, completedAt])
}

model OpenCreditCommercialAccess {
  id              String   @id @default(cuid())
  companyId       String
  providerScope   String
  enabled         Boolean  @default(false)
  changedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  changedBy       User @relation("OpenCreditCommercialAccessChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identities      OpenCreditRemoteIdentity[]
  events          OpenCreditCommercialAccessEvent[]

  @@unique([companyId, providerScope], map: "OCCommercial_company_scope_key")
  @@unique([id, companyId, providerScope], map: "OCCommercial_id_company_scope_key")
  @@index([changedByUserId], map: "OCCommercial_actor_idx")
}

model OpenCreditCommercialAccessEvent {
  id                 String   @id @default(cuid())
  commercialAccessId String
  companyId          String
  providerScope      String
  actorUserId        String
  action             String
  previousEnabled    Boolean?
  nextEnabled        Boolean
  createdAt          DateTime @default(now())
  commercialAccess   OpenCreditCommercialAccess @relation(fields: [commercialAccessId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  actor              User @relation("OpenCreditCommercialAccessEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([commercialAccessId, createdAt, id], map: "OCAccessEvent_access_created_id_idx")
  @@index([actorUserId], map: "OCAccessEvent_actor_idx")
}

model OpenCreditRemoteIdentity {
  consumerAuthorizations OpenCreditConsumerAuthorization[]
  id              String   @id @default(cuid())
  companyId       String
  contactId       String
  providerScope   String
  normalizedCpf   String
  enabled         Boolean  @default(false)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  contact         Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  commercialAccess OpenCreditCommercialAccess @relation(fields: [companyId, providerScope], references: [companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  createdBy       User @relation("OpenCreditRemoteIdentityCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events          OpenCreditRemoteIdentityEvent[]
  operations      OpenCreditCommercialOperation[]

  @@unique([id, companyId, providerScope], map: "OCRemoteIdentity_id_company_scope_key")
  @@unique([providerScope, normalizedCpf], map: "OCRemote_scope_cpf_key")
  @@unique([companyId, providerScope, contactId], map: "OCRemote_company_scope_contact_key")
  @@index([companyId, contactId], map: "OCRemote_company_contact_idx")
  @@index([createdByUserId], map: "OCRemote_actor_idx")
}

model OpenCreditRemoteIdentityEvent {
  id               String   @id @default(cuid())
  remoteIdentityId String
  companyId        String
  providerScope    String
  actorUserId      String
  action           String
  previousEnabled  Boolean?
  nextEnabled      Boolean
  createdAt        DateTime @default(now())
  remoteIdentity   OpenCreditRemoteIdentity @relation(fields: [remoteIdentityId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  actor            User @relation("OpenCreditRemoteIdentityEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([remoteIdentityId, createdAt, id], map: "OCRemoteEvent_identity_created_id_idx")
  @@index([actorUserId], map: "OCRemoteEvent_actor_idx")
}

model OpenCreditCommercialOperation {
  cltAiSimulations OpenCreditAiSimulation[]
  diagnostic       String?
  id               String   @id @default(cuid())
  companyId        String
  remoteIdentityId String
  providerScope    String
  operationKind    String
  intentKey        String
  state            String   @default("PREPARED")
  revision         Int      @default(0)
  createdByUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  remoteIdentity   OpenCreditRemoteIdentity @relation(fields: [remoteIdentityId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  createdBy        User @relation("OpenCreditCommercialOperationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  events           OpenCreditCommercialOperationEvent[]

  @@unique([companyId, providerScope, intentKey], map: "OCOperation_company_scope_intent_key")
  // Production partial unique is maintained explicitly by the correction migration.
  @@index([companyId, providerScope, remoteIdentityId, operationKind], map: "OCOperation_identity_kind_lookup_idx")
  @@unique([id, companyId, providerScope], map: "OCOperation_id_company_scope_key")
  @@index([remoteIdentityId, createdAt, id], map: "OCOperation_identity_created_id_idx")
  @@index([companyId, providerScope, state, createdAt, id], map: "OCOperation_scope_state_created_id_idx")
  @@index([createdByUserId], map: "OCOperation_actor_idx")
}

model OpenCreditCommercialOperationEvent {
  dispatchAuthorizationEventId String?
  dispatchAuthorizationEvent OpenCreditConsumerAuthorizationEvent? @relation("OpenCreditOperationDispatchAuthorizationEvent", fields: [dispatchAuthorizationEventId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction, map: "OCOperationEvent_dispatch_auth_fkey")
  id            String   @id @default(cuid())
  operationId   String
  companyId     String
  providerScope String
  actorUserId   String
  action        String
  previousState String?
  nextState     String
  revision      Int
  createdAt     DateTime @default(now())
  operation     OpenCreditCommercialOperation @relation(fields: [operationId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  actor         User @relation("OpenCreditCommercialOperationEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([dispatchAuthorizationEventId], map: "OCOperationEvent_dispatch_auth_idx")
  @@index([operationId, createdAt, id], map: "OCOperationEvent_operation_created_id_idx")
  @@index([actorUserId], map: "OCOperationEvent_actor_idx")
}

model OpenCreditIntegration {
  whatsappConfigs OpenCreditWhatsappConfig[]
  rolloutBudgets OpenCreditMaterializationRolloutBudget[]
  passiveInboundEnabled Boolean @default(false)
  materializationEnabled Boolean @default(false)
  id              String @id @default(cuid())
  providerScope   String?
  companyId       String
  publicWebhookId String @unique
  webhookSecret   String
  enabled         Boolean @default(false)
  paused          Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company @relation(fields: [companyId], references: [id])
  leads           OpenCreditLead[]
  events          OpenCreditEvent[]
  inboundEvents   OpenCreditInboundEvent[]

  @@unique([companyId, id])
  @@unique([id, companyId, providerScope], map: "OCIntegration_id_company_scope_key")
}

model OpenCreditInboundEvent {
  id                String @id @default(cuid())
  companyId         String
  providerScope     String
  integrationId     String
  eventId           String
  eventType         String
  externalLeadId    String
  contractVersion   Int?
  provenanceKind    String
  provenanceVersion Int
  receivedAt        DateTime @default(now())
  processingState   String @default("RECEIVED")
  integration       OpenCreditIntegration @relation(fields: [integrationId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  materializations  OpenCreditLeadMaterialization[]

  @@unique([companyId, providerScope, eventId], map: "OCInbound_company_scope_event_key")
  @@unique([id, companyId, providerScope, integrationId, externalLeadId], map: "OCInbound_id_company_scope_integration_lead_key")
  @@index([companyId, providerScope, receivedAt], map: "OCInbound_company_scope_received_idx")
}

model OpenCreditLeadMaterialization {
  whatsappHandoffs OpenCreditWhatsappHandoff[]
  rolloutAdmissions OpenCreditMaterializationRolloutAdmission[]
  @@unique([id, companyId, integrationId, providerScope], map: "OCMaterialization_id_binding_key")
  id                String @id @default(cuid())
  companyId         String
  providerScope     String
