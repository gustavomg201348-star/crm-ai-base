  templateVariableMapping String?
  imagePath   String?
  imageName   String?
  imageMime   String?
  imageSize   Int?
  status      String              @default("PENDING")
  total       Int                 @default(0)
  sent        Int                 @default(0)
  delivered   Int                 @default(0)
  failed      Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  company     Company             @relation(fields: [companyId], references: [id])
  channel     Channel             @relation(fields: [channelId], references: [id])
  createdBy   User?               @relation(fields: [createdById], references: [id])
  recipients  CampaignRecipient[]
  chatbotSessions ChatbotSession[]
  replyCorrelations ChatbotReplyCorrelation[]

  @@unique([companyId, channelId, id])
  @@index([companyId])
  @@index([channelId])
  @@index([createdById])
}

model CampaignRecipient {
  id                String    @id @default(cuid())
  campaignId        String
  contactId         String
  conversationId    String?
  phone             String
  status            String    @default("PENDING")
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  resolvedTemplateVariables String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  campaign          Campaign  @relation(fields: [campaignId], references: [id])
  contact           Contact   @relation(fields: [contactId], references: [id])

  chatbotSessions ChatbotSession[]
  replyCorrelations ChatbotReplyCorrelation[]
  @@unique([campaignId, id, contactId, conversationId])
  @@unique([campaignId, contactId])
  @@index([contactId])
  @@index([campaignId, status])
  @@index([contactId, status])
  @@index([conversationId])
  @@index([providerMessageId])
  @@index([status])
}

model Proposal {
  id                String            @id @default(cuid())
  companyId         String
  contactId         String
  multicredClientId String?
  assignedUserId    String?
  bank              String
  agreement         String
  product           String
  operation         String?
  proposalNumber    String?
  contractNumber    String?
  amount            Decimal
  financedAmount    Decimal?
  releasedAmount    Decimal?
  installmentAmount Decimal?
  term              Int?
  commission        Decimal
  commissionReceived Decimal?
  notes             String?
  status            String            @default("DRAFT")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  company           Company           @relation(fields: [companyId], references: [id])
  contact           Contact           @relation(fields: [contactId], references: [id])
  multicredClient   MulticredClient?  @relation(fields: [multicredClientId], references: [id])
  assignedUser      User?             @relation("AssignedProposals", fields: [assignedUserId], references: [id])
  history           ProposalHistory[]

  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, bank])
  @@index([companyId, product])
  @@index([assignedUserId])
  @@index([multicredClientId])
}

model ProposalHistory {
  id         String   @id @default(cuid())
  companyId  String
  proposalId String
  userId     String?
  action     String
  title      String
  detail     String?
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User?    @relation("ProposalHistoryUser", fields: [userId], references: [id])

  @@index([companyId])
  @@index([proposalId, createdAt])
  @@index([userId])
}

model CltIntegration {
  id             String   @id @default(cuid())
  companyId      String
  bankId         String
  bankName       String
  provider       String   @default("manual")
  baseUrl        String?
  authType       String   @default("none")
  apiKey         String?
  username       String?
  password       String?
  newcorbanIdentifier String?
  digitadorCode  String?
  certifiedAgentCpf String?
  actingUf       String?
  smsStatus      String?
  smsRequestedAt DateTime?
  status         String   @default("MANUAL")
  lastTestAt     DateTime?
  lastTestStatus String?
  lastTestMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, bankId])
  @@index([companyId])
  @@index([status])
}

model CltSimulationLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  contactId  String?
  bankId     String?
  bankName   String?
  action     String
  cpf        String?
  phone      String?
  status     String   @default("SUCCESS")
  message    String?
  inputJson  String?
  outputJson String?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  contact    Contact? @relation(fields: [contactId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId])
  @@index([contactId])
  @@index([bankId])
  @@index([status])
}

model OpenCreditWhatsappConfig {
  integrationId String @id
  companyId String
  providerScope String
  defaultWhatsappChannelId String?
  initialTemplateName String?
  initialTemplateLanguage String?
  initialTemplateVariableMapping String?
  autoStartEnabled Boolean @default(false)
  configuredByUserId String
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  integration OpenCreditIntegration @relation(fields: [integrationId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  channel Channel? @relation(fields: [companyId, defaultWhatsappChannelId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  configuredBy User @relation(fields: [companyId, configuredByUserId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
}

model OpenCreditWhatsappHandoff {
  id String @id @default(cuid())
  companyId String
  integrationId String
  providerScope String
  jobId String @unique
  contactId String
  sourceConversationId String @unique
  metaConversationId String @unique
  channelId String
  configRevision Int
  templateName String
  templateLanguage String
  templateFingerprint String
  outboundOperationId String? @unique
  state String @default("PREPARED")
  providerMessageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job OpenCreditLeadMaterialization @relation(fields: [jobId, companyId, integrationId, providerScope], references: [id, companyId, integrationId, providerScope], onDelete: Restrict, onUpdate: NoAction)
  contact Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  sourceConversation Conversation @relation("OpenCreditWhatsappSource", fields: [sourceConversationId, contactId], references: [id, contactId], onDelete: Restrict, onUpdate: NoAction)
  metaConversation Conversation @relation("OpenCreditWhatsappMeta", fields: [metaConversationId, contactId, channelId], references: [id, contactId, channelId], onDelete: Restrict, onUpdate: NoAction)
  channel Channel @relation(fields: [companyId, channelId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction)
  outboundOperation OutboundOperation? @relation(fields: [companyId, channelId, metaConversationId, outboundOperationId], references: [companyId, channelId, conversationId, id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([companyId, contactId])
  @@index([companyId, integrationId, state])
}

model OpenCreditAiSimulation {
  id String @id
  companyId String
  contactId String
  conversationId String
  channelId String
  inboundEventId String
  providerScope String
  authorizationId String
  authorizationRevision Int
  authorityGeneration BigInt
  decisionVersion Int @default(1)
  intent String
  state String @default("RUNNING")
  tokenHash String
  deadlineAt DateTime
  pollCount Int @default(0)
  operationId String? @unique
  protectedFacts String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact Contact @relation(fields: [companyId, contactId], references: [companyId, id], onDelete: Restrict, onUpdate: NoAction, map: "CltAi_contact")
  conversation Conversation @relation(fields: [conversationId, contactId, channelId], references: [id, contactId, channelId], onDelete: Restrict, onUpdate: NoAction, map: "CltAi_conversation")
  evidence ConversationInboundEvent @relation(fields: [inboundEventId, companyId, contactId], references: [id, companyId, contactId], onDelete: Restrict, onUpdate: NoAction, map: "CltAi_evidence")
  authorization OpenCreditConsumerAuthorization @relation(fields: [authorizationId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction, map: "CltAi_authorization")
  operation OpenCreditCommercialOperation? @relation(fields: [operationId, companyId, providerScope], references: [id, companyId, providerScope], onDelete: Restrict, onUpdate: NoAction, map: "CltAi_operation")
  @@unique([companyId, conversationId, inboundEventId], map: "CltAi_inbound_key")
  @@unique([companyId, conversationId, authorizationId, authorizationRevision], map: "CltAi_grant_key")
  @@index([companyId, providerScope, state], map: "CltAi_scope_idx")
}
